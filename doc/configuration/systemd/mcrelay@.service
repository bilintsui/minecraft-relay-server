[Unit]
Description=Minecraft Relay Server (%i)
Documentation=man:mcrelay(1) https://github.com/bilintsui/minecraft-relay-server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/log/mcrelay
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
KillMode=control-group
Restart=on-failure
RestartSec=5s
TasksMax=512
ExecStart=/usr/local/bin/mcrelay run --config /usr/local/etc/mcrelay/%i.json
ExecReload=/bin/kill -USR1 $MAINPID

[Install]
WantedBy=multi-user.target
