// These comments are only valid in JSONC. Remove them when writing your own configuration for JSON compliance.
{
  // Optional, log settings
  "log": {
    /*
     * Optional, string (default: "/var/log/mcrelay/access.log")
     *
     * The file where logs are saved
     */
    "filename": "/var/log/mcrelay/access.log",

    /*
     * Optional, short integer (default: 2)
     *
     * The maximum log level you want to be logged
     */
    "level": 2
  },
  // Optional, bind settings
  "listen": {
    /*
     * Optional, string (default: "::")
     *
     * The numeric IPv4 or IPv6 address that the server will listen on
     */
    "address": "::",

    /*
     * Optional, unsigned short integer (0-65535) (default: 25565)
     *
     * The port that the server will listen on
     */
    "port": 25565
  },
  // Optional, custom icon displayed on server list, when connection cannot be established
  "icon": "",	// Use barrier by default
  // Mandatory, proxy list
  "proxy": [
    {
      /*
       * Mandatory, string or string array
       *
       * Virtual hostname, used for choosing target server
       */
      "vhost": "mc.example.com",

      /*
       * Mandatory, string
       * Address or hostname of target server
       * Hostnames prefer the inbound client's IP family and automatically fall back to the other family
       */
      "address": "localhost",

      /*
       * Optional, short integer
       *
       * Port of the target server
       * When not set, this server will resolve the address as an SRV record
       */
      "port": 25565,

      /*
       * Optional, boolean or integer (default: false)
       *
       * When set to true, this means the server will rewrite the address and port fields in the outgoing handshake packet
       */
      "rewrite": false,

      /*
       * Optional, boolean or integer (default: false)
       *
       * When set to true, this means the server will use HAProxy's Proxy Protocol
       * Note: To enable this, you need to make sure your target server supports this protocol; otherwise, your connection will be closed
       */
      "pheader": false
    },
    {
      "vhost": [
        "mc1.example.com",
        "mc2.example.com"
      ],
      "address": "mc.example2.com",
      "rewrite": false,
      "pheader": false
    },
    {
      "vhost": "hypixel.example.com",
      "address": "mc.hypixel.net",
      "port": 25565,
      "rewrite": true,
      "pheader": false
    }
  ]
}
