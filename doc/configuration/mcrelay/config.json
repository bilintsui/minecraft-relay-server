{
  "log": {
    "filename": "/var/log/mcrelay/access.log",
    "level": 2
  },
  "metrics": {
    "interval": 0
  },
  "listen": {
    "address": "::",
    "port": 25565,
    "allow_proxy": false,
    "proxy_settings": {
      "version": 1,
      "trusted_sources": [
        "127.0.0.0/8",
        "::1"
      ],
      "untrusted_policy": "reject"
    }
  },
  "icon": "",
  "proxy": [
    {
      "vhost": "mc.example.com",
      "address": "localhost",
      "port": 25565,
      "rewrite": false,
      "pheader": false
    },
    {
      "vhost": [
        "mc1.example.com",
        "mc2.example.com"
      ],
      "address": "mc.example2.com",
      "rewrite": false,
      "pheader": false
    },
    {
      "vhost": "hypixel.example.com",
      "address": "mc.hypixel.net",
      "port": 25565,
      "rewrite": true,
      "pheader": false
    }
  ]
}
